{
  "manifest_version": 3,
  "name": "Click Timing Recorder",
  "version": "1.0.0",
  "description": "Records clicks, typing, page URLs and timing so they can be replayed with Puppeteer.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Click Timing Recorder"
  }
}
